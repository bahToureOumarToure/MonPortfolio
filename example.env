# --- EmailJS (formulaire de contact, côté client) ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Base de données (Vercel Postgres / Neon) ---
# DATABASE_URL : URL "pooled" utilisée par l'application au runtime.
# DIRECT_URL   : URL directe utilisée par Prisma pour les migrations.
DATABASE_URL=
DIRECT_URL=

# --- Auth.js / NextAuth (générer: `npx auth secret` ou `openssl rand -base64 32`) ---
AUTH_SECRET=

# --- Passkey / WebAuthn ---
AUTH_WEBAUTHN_RP_ID=localhost
AUTH_WEBAUTHN_RP_NAME=Bah Oumar Touré — Admin
AUTH_WEBAUTHN_ORIGIN=http://localhost:3000

# --- Vercel Blob (stockage des médias & du CV) ---
BLOB_READ_WRITE_TOKEN=

# --- Admin unique : e-mail du seul compte autorisé à administrer le site ---
ADMIN_EMAIL=
